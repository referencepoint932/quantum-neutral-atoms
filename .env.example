# =============================================================================
# Example environment configuration for quantum-neutral-atoms
#
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Azure Quantum workspace
# Find these in the Azure Portal under your Quantum Workspace > Overview.
# -----------------------------------------------------------------------------
AZURE_QUANTUM_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_QUANTUM_RESOURCE_GROUP="my-resource-group"
AZURE_QUANTUM_WORKSPACE_NAME="my-quantum-workspace"
AZURE_QUANTUM_LOCATION="westeurope"

# Service-principal authentication (recommended for headless / CI runs).
# Leave blank to fall back to interactive `az login`.
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_SECRET="your-service-principal-secret"

# -----------------------------------------------------------------------------
# Pasqal Cloud / hardware target
# Obtain credentials from https://portal.pasqal.cloud/
# -----------------------------------------------------------------------------
PASQAL_USERNAME="you@example.com"
PASQAL_PASSWORD="your-pasqal-password"
PASQAL_PROJECT_ID="00000000-0000-0000-0000-000000000000"

# Target device to submit jobs to (e.g. an emulator or a QPU).
# Examples: "pasqal.sim.emu-tn", "pasqal.qpu.fresnel"
PASQAL_TARGET="pasqal.sim.emu-tn"

# -----------------------------------------------------------------------------
# Run configuration
# -----------------------------------------------------------------------------
# Use a local simulator instead of submitting to the cloud (true/false).
USE_LOCAL_SIMULATOR="true"

# Default number of measurement shots per circuit.
N_SHOTS="1000"

# Directory for simulation outputs and checkpoints (git-ignored).
RESULTS_DIR="results/"

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"
